# Game data stays on your machine: ROMs and anything made from them
*.z64
*.n64
*.v64
*.sf2
*.otr
*.o2r

__pycache__/
*.pyc

# Lilo: the FBX export is large and made from the .blend (tools/lilo/build_lilo.py); the previews are rendered on demand
assets/lilo/lilo.fbx
assets/lilo/lilo.blend1
assets/lilo/previews/

# Avriella: the FBX export is large and made from the .blend (tools/avriella/build_avriella.py); the previews are rendered on demand
assets/avriella/avriella.fbx
assets/avriella/avriella.blend1
assets/avriella/previews/

# Fish authoring backups and on-demand previews
assets/fish/*.blend1
assets/fish/previews/

