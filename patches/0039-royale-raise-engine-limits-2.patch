index 5a1893c..317b06e 100644
--- a/soh/src/code/z_bgcheck.c
+++ b/soh/src/code/z_bgcheck.c
@@ -1588,14 +1588,16 @@ void BgCheck_Allocate(CollisionContext* colCtx, PlayState* play, CollisionHeader
         extern s32 Royale_IsCustomCollision(CollisionHeader * header);
         if (Royale_IsCustomCollision(colHeader)) {
             // OOT Royale (limits for modern phones like the Odin 2 Portal): node numbers are 32 bit now, so this is no longer capped at 65535.
-            // 0xC0000 is quadrupled below to 3 MB: room for about 390000 list nodes. Finer cells keep the lists short on bigger maps.
-            colCtx->memSize = 0xC0000;
-            colCtx->subdivAmount.x = 64;
-            colCtx->subdivAmount.y = 4;
-            colCtx->subdivAmount.z = 64;
-            colCtx->dyna.polyListMax = 4096; // doubled below: room for 8192 moving/solid-scenery polygons (was 1024)
-            colCtx->dyna.vtxListMax = 4096;
-            colCtx->dyna.polyNodesMax = 8192 + 512; // one node per moving polygon (8192 after doubling) plus headroom
+            // Round 2 (patches/0039, maps that fill the whole +-32767 world with hundreds of thousands of triangles): 0x400000 is quadrupled
+            // below to 16 MB, room for about 2 million list nodes (was 0xC0000, 390000). 256 x 8 x 256 cells are about 250 units across on a
+            // world-wide map (were 64 x 4 x 64, about 1000), so every raycast walks a short list.
+            colCtx->memSize = 0x400000;
+            colCtx->subdivAmount.x = 256;
+            colCtx->subdivAmount.y = 8;
+            colCtx->subdivAmount.z = 256;
+            colCtx->dyna.polyListMax = 16384; // doubled below: room for 32768 moving/solid-scenery polygons (was 8192, 1024 originally)
+            colCtx->dyna.vtxListMax = 16384;
+            colCtx->dyna.polyNodesMax = 32768 + 2048; // one node per moving polygon (32768 after doubling) plus headroom
         }
     }
     colCtx->lookupTbl = THA_AllocEndAlign(
