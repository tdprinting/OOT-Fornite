--- a/soh/include/z64.h
+++ b/soh/include/z64.h
@@ -39,9 +39,9 @@
 #endif
 
 #define AUDIO_HEAP_SIZE  0x380000
-// OOT Royale: was 4 MB. The play heap (64 MB, z_play.c) and every other game state heap come from it. 128 MB is small next to
-// the Odin 2 Portal's 8-16 GB, and pages the game never touches are never backed by real memory.
-#define SYSTEM_HEAP_SIZE (1024 * 1024 * 128)
+// OOT Royale: was 4 MB (128 MB before patches/0039). The play heap (160 MB, z_play.c) and every other game state heap come from it. 256 MB is
+// small next to the Odin 2 Portal's 8-16 GB, and pages the game never touches are never backed by real memory.
+#define SYSTEM_HEAP_SIZE (1024 * 1024 * 256)
 
 #ifdef __cplusplus
 namespace LUS
@@ -97,12 +97,14 @@ typedef struct {
 
 typedef struct {
     /* 0x00000 */ u16 headMagic; // GFXPOOL_HEAD_MAGIC
-    // OOT Royale: 4x the original display-list buffers (limits for modern phones like the Odin 2 Portal). They were 0x2FC0, 0x1000, 0x800 and 0x100
-    // commands; when one overflows the whole frame is dropped, and the solid buffer also holds each frame's Graph_Alloc data.
-    Gfx polyOpaBuffer[0x2FC0 * 4];
-    Gfx polyXluBuffer[0x1000 * 4];
-    Gfx overlayBuffer[0x800 * 4];
-    Gfx workBuffer[0x100 * 4];
+    // OOT Royale: bigger display-list buffers (limits for modern phones like the Odin 2 Portal). They were 0x2FC0, 0x1000, 0x800 and 0x100
+    // commands; when one overflows the whole frame is dropped, and the solid buffer also holds each frame's Graph_Alloc data. patches/0029 made
+    // them 4x; patches/0039 makes the solid and see-through ones 16x (about 1.5 MB and 0.5 MB) and the overlay and work ones 8x, for maps that
+    // draw hundreds of batches a frame.
+    Gfx polyOpaBuffer[0x2FC0 * 16];
+    Gfx polyXluBuffer[0x1000 * 16];
+    Gfx overlayBuffer[0x800 * 8];
+    Gfx workBuffer[0x100 * 8];
     /* 0x11308 */ Gfx unusedBuffer[0x40];
     /* 0x12408 */ u16 tailMagic; // GFXPOOL_TAIL_MAGIC
 } GfxPool; // size = 0x24820 in the original
