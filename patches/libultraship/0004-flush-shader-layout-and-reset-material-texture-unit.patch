diff --git a/src/graphic/Fast3D/gfx_pc.cpp b/src/graphic/Fast3D/gfx_pc.cpp
--- a/src/graphic/Fast3D/gfx_pc.cpp
+++ b/src/graphic/Fast3D/gfx_pc.cpp
@@ -210,6 +210,9 @@
 static struct ShaderProgram* gfx_lookup_or_create_shader_program(uint64_t shader_id0, uint32_t shader_id1) {
     struct ShaderProgram* prg = gfx_rapi->lookup_shader(shader_id0, shader_id1);
     if (prg == NULL) {
+        // Compilation binds the new program and vertex stride. Draw queued
+        // triangles with their original layout before either one changes.
+        gfx_flush();
         gfx_rapi->unload_shader(rendering_state.shader_program);
         prg = gfx_rapi->create_and_load_new_shader(shader_id0, shader_id1);
         rendering_state.shader_program = prg;
@@ -3071,6 +3074,9 @@
         gfx_rapi->select_texture(6 + i, it->second);
         gfx_rapi->set_sampler_parameters(6 + i, true, G_TX_WRAP, G_TX_WRAP);
     }
+    // Framebuffer helpers bind textures on the active unit. Never leave a
+    // private material sampler active for subsequent scene/UI operations.
+    if (gfx_rapi->reset_texture_unit) gfx_rapi->reset_texture_unit();
     return false;
 }

