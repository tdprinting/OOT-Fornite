diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index cec9d60..5bb4ace 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -18,6 +18,16 @@ endif()
 
 configure_file( ${CMAKE_CURRENT_SOURCE_DIR}/install_config.h.in ${CMAKE_CURRENT_BINARY_DIR}/install_config.h @ONLY)
 
+# The default OpenGL shaders, built in: the game falls back to them when its asset archive carries older shaders.
+file(READ ${CMAKE_CURRENT_SOURCE_DIR}/graphic/Fast3D/shaders/opengl/default.shader.vs LUS_EMBEDDED_VS)
+file(READ ${CMAKE_CURRENT_SOURCE_DIR}/graphic/Fast3D/shaders/opengl/default.shader.fs LUS_EMBEDDED_FS)
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/lus_embedded_shaders.h.tmp
+     "#pragma once\nstatic const char* const kEmbeddedShader_vs = R\"lusshader(${LUS_EMBEDDED_VS})lusshader\";\nstatic const char* const kEmbeddedShader_fs = R\"lusshader(${LUS_EMBEDDED_FS})lusshader\";\n")
+configure_file(${CMAKE_CURRENT_BINARY_DIR}/lus_embedded_shaders.h.tmp ${CMAKE_CURRENT_BINARY_DIR}/lus_embedded_shaders.h COPYONLY)
+set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+             ${CMAKE_CURRENT_SOURCE_DIR}/graphic/Fast3D/shaders/opengl/default.shader.vs
+             ${CMAKE_CURRENT_SOURCE_DIR}/graphic/Fast3D/shaders/opengl/default.shader.fs)
+
 file(GLOB Source_Files__TopLevel RELATIVE ${CMAKE_CURRENT_SOURCE_DIR} "*.h" "*.cpp")
 
 source_group("" FILES ${Source_Files__TopLevel})
