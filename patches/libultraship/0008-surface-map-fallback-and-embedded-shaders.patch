+    // material attributes the renderer writes always match the program.
+    if (shader->find("o_surface_map") == std::string::npos) {
+        static std::string embedded = kEmbeddedShader_vs;
+        shader = &embedded;
+    }
     processor.load(*shader);
     processor.bind_include_loader(opengl_include_fs);
