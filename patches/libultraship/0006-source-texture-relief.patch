+static void gfx_bind_surface_textures(const GfxSurfaceMap* map,uint32_t cms,uint32_t cmt) {
+    static const uint8_t* lastNormal=nullptr;static const uint8_t* lastHeight=nullptr;
+    static uint32_t lastW=0,lastH=0,lastS=~0u,lastT=~0u;
+    if(lastNormal==map->normal && lastHeight==map->height && lastW==map->width && lastH==map->heightPixels && lastS==cms && lastT==cmt)return;
