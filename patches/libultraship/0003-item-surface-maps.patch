+bool gfx_surface_map_handler(F3DGfx** cmd0) {
+    gfx_flush(); // Descriptors and texture bindings must never change in a batch.
+    surface_map = reinterpret_cast<const GfxSurfaceMap*>((*cmd0)->words.w1);
+    if (!surface_map || strcmp(gfx_rapi->get_name(), "OpenGL") != 0) return false;
+    if (surface_map->width == 0 || surface_map->heightPixels == 0 ||
+        surface_map->width > 2048 || surface_map->heightPixels > 2048) {
+        surface_map = nullptr;
+        return false;
+    }
+    // RGBA keeps upload byte order identical on Windows and Android. Units 6/7
+    // are private material samplers and do not invalidate the colour texture cache.
+    static const uint8_t flatNormal[] = { 128, 128, 255, 255 };
+    static const uint8_t flatHeight[] = { 128, 128, 128, 255 };
+    for (int i = 0; i < 2; ++i) {
+        const uint8_t* data = i == 0 ? surface_map->normal : surface_map->height;
+        const bool flat = data == nullptr;
+        if (flat) data = i == 0 ? flatNormal : flatHeight;
+        SurfaceTextureKey key { data, flat ? 1u : surface_map->width, flat ? 1u : surface_map->heightPixels };
+        auto it = surface_textures.find(key);
+        if (it == surface_textures.end()) {
+            const uint32_t id = gfx_rapi->new_texture();
+            gfx_rapi->select_texture(6 + i, id);
+            gfx_rapi->upload_texture(data, key.width, key.height);
+            it = surface_textures.emplace(key, id).first;
+        }
+        gfx_rapi->select_texture(6 + i, it->second);
+        gfx_rapi->set_sampler_parameters(6 + i, true, G_TX_WRAP, G_TX_WRAP);
+    }
+    return false;
 }
 
