@@ -0,0 +1,260 @@
+package com.dishii.soh;
+
+import android.app.Activity;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.util.Log;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+// Full screen loading screen shown over the (still black) game surface while the app sets up its files, finds the ROM
+// and extracts the game assets. Shows the current step, a progress bar, how long the step has been running, a warning
+// when nothing has moved for a while, and errors. Safe to call from any thread.
+public class LoadingOverlay {
+    private static final String TAG = "RoyaleLoading";
+    private static final int TICK_MS = 1000;
+
+    private final Activity activity;
+    private final Handler ui = new Handler(Looper.getMainLooper());
+    private FrameLayout root;
+    private TextView stepText, detailText, percentText, timeText, warningText, errorTitle, errorText;
+    private ProgressBar bar;
+    private Button closeButton;
+
+    // State (only touched on the UI thread)
+    private String step = "", detail = "";
+    private int percent = -1;
+    private int stallSeconds = 30;
+    private boolean waitingForUser = false;
+    private boolean failed = false;
+    private boolean done = false;
+    private long startTime, stepStartTime, lastChangeTime;
+
+    public LoadingOverlay(Activity activity) {
+        this.activity = activity;
+        startTime = stepStartTime = lastChangeTime = SystemClock.elapsedRealtime();
+    }
+
+    // Must be called on the UI thread once the content view exists.
+    public void attach(ViewGroup parent) {
+        root = new FrameLayout(activity);
+        root.setBackgroundColor(Color.rgb(12, 16, 22));
+        root.setClickable(true); // swallow touches so the on-screen controller underneath is not pressed
+        root.setFocusable(true);
+
+        LinearLayout box = new LinearLayout(activity);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setGravity(Gravity.CENTER_HORIZONTAL);
+        int pad = dp(24);
+        box.setPadding(pad, pad, pad, pad);
+
+        TextView title = text(26, Color.rgb(232, 200, 96));
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        title.setText("TDawgs Battle Royale");
+        title.setGravity(Gravity.CENTER);
+        box.addView(title);
+
+        stepText = text(20, Color.WHITE);
+        stepText.setGravity(Gravity.CENTER);
+        stepText.setPadding(0, dp(18), 0, dp(10));
+        box.addView(stepText);
+
+        bar = new ProgressBar(activity, null, android.R.attr.progressBarStyleHorizontal);
+        bar.setMax(1000);
+        box.addView(bar, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(14)));
+
+        LinearLayout row = new LinearLayout(activity);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        detailText = text(14, Color.rgb(170, 178, 190));
+        row.addView(detailText, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        percentText = text(14, Color.rgb(170, 178, 190));
+        row.addView(percentText);
+        row.setPadding(0, dp(6), 0, 0);
+        box.addView(row, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        timeText = text(13, Color.rgb(120, 128, 140));
+        timeText.setPadding(0, dp(4), 0, 0);
+        box.addView(timeText, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        warningText = text(15, Color.rgb(255, 176, 64));
+        warningText.setPadding(0, dp(14), 0, 0);
+        warningText.setVisibility(View.GONE);
+        box.addView(warningText);
+
+        errorTitle = text(20, Color.rgb(255, 92, 92));
+        errorTitle.setTypeface(Typeface.DEFAULT_BOLD);
+        errorTitle.setPadding(0, dp(16), 0, dp(4));
+        errorTitle.setVisibility(View.GONE);
+        box.addView(errorTitle);
+
+        errorText = text(15, Color.rgb(255, 210, 210));
+        errorText.setVisibility(View.GONE);
+        box.addView(errorText);
+
+        closeButton = new Button(activity);
+        closeButton.setText("Close app");
+        closeButton.setVisibility(View.GONE);
+        closeButton.setOnClickListener(v -> {
+            activity.finishAffinity();
+            System.exit(0);
+        });
+        LinearLayout.LayoutParams blp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT);
+        blp.topMargin = dp(16);
+        box.addView(closeButton, blp);
+
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(dp(560), ViewGroup.LayoutParams.WRAP_CONTENT,
+                Gravity.CENTER);
+        root.addView(box, lp);
+        parent.addView(root, new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT));
+
+        render();
+        ui.postDelayed(tick, TICK_MS);
+    }
+
+    // percent: 0..100, or -1 when the step has no measurable progress (the bar animates instead).
+    // stallSeconds: how long the step may go without any change before the "taking too long" warning shows.
+    public void setStatus(String newStep, String newDetail, int newPercent, int newStallSeconds) {
+        ui.post(() -> {
+            if (done || failed) return;
+            long now = SystemClock.elapsedRealtime();
+            String s = newStep == null ? "" : newStep;
+            String d = newDetail == null ? "" : newDetail;
+            if (!s.equals(step)) stepStartTime = now;
+            if (!s.equals(step) || !d.equals(detail) || newPercent != percent) lastChangeTime = now;
+            step = s;
+            detail = d;
+            percent = newPercent;
+            stallSeconds = newStallSeconds;
+            waitingForUser = false;
+            Log.i(TAG, step + (detail.isEmpty() ? "" : " | " + detail) + (percent >= 0 ? " | " + percent + "%" : ""));
+            render();
+        });
+    }
+
+    // While a question or the file picker is up, the stall warning is paused: the app is waiting on the player.
+    public void setWaitingForUser(boolean waiting) {
+        ui.post(() -> {
+            if (waitingForUser == waiting) return;
+            waitingForUser = waiting;
+            lastChangeTime = SystemClock.elapsedRealtime();
+            render();
+        });
+    }
+
+    public void showError(String title, String message) {
+        ui.post(() -> {
+            if (done) return;
+            failed = true;
+            Log.e(TAG, "Error: " + title + ": " + message);
+            render();
+            errorTitle.setText(title);
+            errorText.setText(message + "\n\nYour files are kept. Close the app and open it again to retry.");
+        });
+    }
+
+    // Back to normal after a problem the player fixed without restarting (e.g. granting file access in Settings).
+    public void clearError() {
+        ui.post(() -> {
+            if (!failed) return;
+            failed = false;
+            errorTitle.setVisibility(View.GONE);
+            errorText.setVisibility(View.GONE);
+            render();
+        });
+    }
+
+    public void finish() {
+        ui.post(() -> {
+            if (done) return;
+            done = true;
+            ui.removeCallbacks(tick);
+            if (root != null && root.getParent() != null) {
+                ((ViewGroup) root.getParent()).removeView(root);
+            }
+            Log.i(TAG, "Loading finished after " + seconds(SystemClock.elapsedRealtime() - startTime) + "s");
+        });
+    }
+
+    private final Runnable tick = new Runnable() {
+        @Override
+        public void run() {
+            if (done) return;
+            render();
+            ui.postDelayed(this, TICK_MS);
+        }
+    };
+
+    private void render() {
+        if (root == null) return;
+        long now = SystemClock.elapsedRealtime();
+
+        stepText.setText(step.isEmpty() ? "Starting..." : step);
+        detailText.setText(waitingForUser ? "Waiting for you..." : detail);
+        if (percent >= 0) {
+            bar.setIndeterminate(false);
+            bar.setProgress(Math.min(1000, percent * 10));
+            percentText.setText(percent + "%");
+        } else {
+            bar.setIndeterminate(!failed);
+            percentText.setText("");
+        }
+        timeText.setText("This step: " + clock(now - stepStartTime) + "    Total: " + clock(now - startTime));
+
+        if (failed) {
+            warningText.setVisibility(View.GONE);
+            errorTitle.setVisibility(View.VISIBLE);
+            errorText.setVisibility(View.VISIBLE);
+            closeButton.setVisibility(View.VISIBLE);
+            return;
+        }
+
+        long quiet = seconds(now - lastChangeTime);
+        if (!waitingForUser && stallSeconds > 0 && quiet >= stallSeconds) {
+            boolean veryLong = quiet >= stallSeconds * 4L;
+            warningText.setText((veryLong ? "This looks stuck. " : "This is taking longer than usual. ")
+                    + "Nothing has changed for " + clock(quiet * 1000) + ".\n"
+                    + (veryLong ? "Close the app and open it again; setup will start over safely."
+                                : "It may still finish. If this keeps counting up for a few minutes, the app is stuck."));
+            warningText.setVisibility(View.VISIBLE);
+            closeButton.setVisibility(veryLong ? View.VISIBLE : View.GONE);
+        } else {
+            warningText.setVisibility(View.GONE);
+            closeButton.setVisibility(View.GONE);
+        }
+    }
+
+    private TextView text(int sp, int color) {
+        TextView t = new TextView(activity);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        return t;
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                activity.getResources().getDisplayMetrics());
+    }
+
+    private static long seconds(long ms) {
+        return ms / 1000;
+    }
+
+    private static String clock(long ms) {
+        long s = ms / 1000;
+        return String.format(java.util.Locale.US, "%d:%02d", s / 60, s % 60);
+    }
+}
