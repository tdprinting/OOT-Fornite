+// std::filesystem::copy can leave a file short or missing on Android's external storage. Compare every copied file
+// with its source and redo the ones that differ with a plain read/write copy, so ZAPD never starts on a bad file.
+static void VerifyCopiedAssets(const std::string& from, const std::string& to) {
+    std::error_code ec;
+    size_t total = 0, fixed = 0;
+    for (const auto& entry : std::filesystem::recursive_directory_iterator(from, ec)) {
+        if (!entry.is_regular_file(ec)) {
+            continue;
+        }
+        total++;
+        std::filesystem::path dest = std::filesystem::path(to) / std::filesystem::relative(entry.path(), from, ec);
