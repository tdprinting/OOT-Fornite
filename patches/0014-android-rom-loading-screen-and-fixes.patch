+// Extraction gets 5-90% of the bar, packing the archive the rest.
+static void ReportZapdProgress(int done, int total) {
+    static int sLastDone = -1;
+    if (done == sLastDone) {
+        return;
+    }
+    sLastDone = done;
+    if (total > 0 && done < total) {
+        char detail[64];
+        snprintf(detail, sizeof(detail), "%d of %d asset files", done, total);
+        SohLoading_SetStatus("Extracting game assets from your ROM", detail, 5 + 85 * done / total, 120);
+    } else {
+        SohLoading_SetStatus("Packing the game archive", "Writing all assets into one file", 90, 240);
+    }
+}
