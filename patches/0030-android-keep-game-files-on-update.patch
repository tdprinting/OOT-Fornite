diff --git a/Android/app/build.gradle b/Android/app/build.gradle
index 79ceb6c..0b0710c 100644
--- a/Android/app/build.gradle
+++ b/Android/app/build.gradle
@@ -115,3 +115,23 @@ task wrapper(type: Wrapper) {
 
 task prepareKotlinBuildScriptModel {
 }
+
+// OOT Royale (patches/0030): fingerprints of the game files this APK unpacks, so an update only rebuilds what really changed.
+// MainActivity keeps the ROM-built oot.otr across updates unless EXTRACTOR_VERSION changes, and re-copies soh.otr only when
+// SOH_OTR_VERSION changes. Bump ROYALE_EXTRACT_REVISION when an extractor change (patches/ZAPDTR) changes what it writes.
+def ROYALE_EXTRACT_REVISION = 2
+def royaleFingerprint = { List<File> roots ->
+    def digest = java.security.MessageDigest.getInstance("SHA-1")
+    roots.each { root ->
+        def files = root.isDirectory() ? fileTree(root).files.sort { it.path } : (root.isFile() ? [root] : [])
+        files.each { f ->
+            digest.update(root.toPath().relativize(f.toPath()).toString().replace('\\', '/').getBytes("UTF-8"))
+            f.withInputStream { s -> byte[] buf = new byte[65536]; int n; while ((n = s.read(buf)) > 0) digest.update(buf, 0, n) }
+        }
+    }
+    digest.digest().encodeHex().toString().substring(0, 16)
+}
+android.defaultConfig.buildConfigField "String", "EXTRACTOR_VERSION",
+        "\"r${ROYALE_EXTRACT_REVISION}-${royaleFingerprint([file('src/main/assets/assets')])}\""
+android.defaultConfig.buildConfigField "String", "SOH_OTR_VERSION",
+        "\"${royaleFingerprint([file('src/main/assets/soh.otr')])}\""
