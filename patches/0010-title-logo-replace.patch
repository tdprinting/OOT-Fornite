+// OOT Royale: the game's own title logo is replaced by the mod's picture (a plain RGBA image) when the mod has one. It is drawn right here, in
+// the title's own draw, so it fades in with the title's own fade and the original logo and its two lines of text are not drawn at all.
+extern const unsigned char* Royale_TitleLogoRGBA(int* width, int* height, int* destWidth, int* destHeight);
+
 #define FLAGS (ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED)
 
 void EnMag_Init(Actor* thisx, PlayState* play);
@@ -483,6 +487,25 @@ bool EnMag_ShouldDrawPressStart(Font* font, Gfx** gfxP, bool isActualText) {
 
 // Title logo is shifted to the left in Master Quest
 #define LOGO_X_SHIFT (isMQ ? 0 : -8)
+
+static void EnMag_DrawCustomLogo(Gfx** gfxp, s16 centerX, s16 centerY, const unsigned char* source, u32 width, u32 height, u32 destW, u32 destH) {
+    Gfx* gfx = *gfxp;
+    s32 left = centerX - (s32)(destW / 2);
+    s32 top = centerY - (s32)(destH / 2);
+
+    Gfx_SetupDL_56Ptr(&gfx);
+
+    gDPSetTileCustom(gfx++, G_IM_FMT_RGBA, G_IM_SIZ_32b, width, height, 0, G_TX_NOMIRROR | G_TX_CLAMP,
+                     G_TX_NOMIRROR | G_TX_CLAMP, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
+    gDPSetTextureImage(gfx++, G_IM_FMT_RGBA, G_IM_SIZ_32b, width, source);
+    gDPLoadSync(gfx++);
+    gDPLoadTile(gfx++, G_TX_LOADTILE, 0, 0, (width - 1) << 2, (height - 1) << 2);
+    gDPSetTextureFilter(gfx++, G_TF_BILERP);
+    gSPTextureRectangle(gfx++, left << 2, top << 2, (left + (s32)destW) << 2, (top + (s32)destH) << 2, G_TX_RENDERTILE, 0,
+                        0, (width << 10) / destW, (height << 10) / destH);
+
+    *gfxp = gfx;
+}
 #define LOGO_TEX (isMQ ? gTitleZeldaShieldLogoMQTex : gTitleZeldaShieldLogoTex)
 // Copyright texture is different depending on the version
