+// OOT Royale: the adult hand patches below put a one-word call over a two-word command (a texture set by hash), which left the hash word
+// behind to run as a bad command ("Unhandled OP code: 0x30" each time adult Link holding the Kokiri sword was drawn). Blank that word too.
+static void PatchHandCall(const char* path, const char* name, int index, Gfx call) {
+    const std::string tail = std::string(name) + "Tail";
+    ResourceMgr_UnpatchGfxByName(path, tail.c_str());
+    ResourceMgr_UnpatchGfxByName(path, name);
+    Gfx* dl = ResourceMgr_LoadGfxByName(path);
+    const uint8_t op = dl != nullptr ? (uint8_t)(dl[index].words.w0 >> 24) : 0;
+    const bool twoWords = op == G_SETTIMG_OTR_HASH || op == G_DL_OTR_HASH || op == G_VTX_OTR_HASH || op == G_MARKER || op == G_BRANCH_Z_OTR ||
+                          op == G_MTX_OTR;   // the commands the resource loader reads as two words
+    ResourceMgr_PatchGfxByName(path, name, index, call);
+    if (twoWords) {
+        ResourceMgr_PatchGfxByName(path, tail.c_str(), index + 1, gsDPNoOp());
+    }
+}
+static void UnpatchHandCall(const char* path, const char* name) {
+    ResourceMgr_UnpatchGfxByName(path, (std::string(name) + "Tail").c_str());
+    ResourceMgr_UnpatchGfxByName(path, name);
+}
