             colCtx->subdivAmount.z = 16;
         }
     }
+    {
+        // OOT Royale: the Fortnite map's ground is thousands of triangles over a wide area: finer cells, and room for their lists.
+        extern s32 Royale_IsCustomCollision(CollisionHeader * header);
+        if (Royale_IsCustomCollision(colHeader)) {
+            colCtx->memSize = 0x23000; // doubled below like every scene: room for about 58000 list nodes (the most a u16 count allows is 65535)
+            colCtx->subdivAmount.x = 32;
+            colCtx->subdivAmount.y = 2;
+            colCtx->subdivAmount.z = 32;
+        }
+    }
     colCtx->lookupTbl = THA_AllocEndAlign(
         &play->state.tha,
         colCtx->subdivAmount.x * sizeof(StaticLookup) * colCtx->subdivAmount.y * colCtx->subdivAmount.z, ~1);
