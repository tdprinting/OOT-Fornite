+
+static void RecordWorkerFailure(const std::string& message)
+{
+	printf("Error: %s\n", message.c_str());
+	numWorkersFailed++;
+	std::lock_guard<std::mutex> lock(sZapdErrorMutex);
+	if (sZapdFirstError.empty())
+		sZapdFirstError = message;
+}
+
+// Runs one XML file. Always counts the worker as finished, even when it fails or throws (errors from
+// HANDLE_ERROR are exceptions), so the wait loop always ends.
+static void RunExtractWorker(int workerID, int fileListSize, const std::string& fileListItem,
+                             ZFileMode fileMode)
+{
+	try
+	{
+		if (ExtractFunc(workerID, fileListSize, fileListItem, fileMode) != 0)
+			RecordWorkerFailure("could not extract " + fileListItem);
+	}
+	catch (const std::exception& e)
+	{
+		RecordWorkerFailure(fileListItem + ": " + e.what());
+	}
+	catch (...)
+	{
+		RecordWorkerFailure(fileListItem + ": unknown error");
+	}
+	numWorkersLeft--;
+}
 
